# ============================================================================
# LLM API CONFIGURATION
# ============================================================================

# OPTION 1: Exercise-Provided Proxy (if you have access)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.example.com/v1
ANTHROPIC_API_BASE=https://api.example.com/v1
NORMALIZER_MODEL=evals-anthropic/claude-haiku-4-0
AGENT_MODEL=evals-anthropic/claude-sonnet-4-0

# OPTION 2: OpenRouter (Free Tier Available!)
# -----------------------------------------------------------------------------
# Sign up at: https://openrouter.ai/
# Free models: google/gemma-2-9b-it, meta-llama/llama-3.1-8b-instruct, etc.
# Uncomment the lines below and comment out Option 1:
#
# OPENAI_API_KEY=your-openrouter-api-key
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# NORMALIZER_MODEL=google/gemma-2-9b-it:free
# AGENT_MODEL=meta-llama/llama-3.1-70b-instruct:free

# OPTION 3: Direct Anthropic/OpenAI (Paid)
# -----------------------------------------------------------------------------
# Anthropic API: https://console.anthropic.com/
# OpenAI API: https://platform.openai.com/
#
# OPENAI_API_KEY=your-anthropic-or-openai-key
# NORMALIZER_MODEL=claude-haiku-4-0
# AGENT_MODEL=claude-sonnet-4-0
# or
# NORMALIZER_MODEL=gpt-4o-mini
# AGENT_MODEL=gpt-4o

# ============================================================================
# GITHUB INTEGRATION (for lilagent-github mode)
# ============================================================================

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo (full control of private repositories)
GITHUB_TOKEN=your-github-token-here

# Repository to work with (format: owner/repo)
GITHUB_REPO=your-username/your-repo

# Default branch (usually 'main' or 'master')
GITHUB_DEFAULT_BRANCH=main

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================

# URL to POST blocking issues when master agent needs user input
# Optional - leave commented out if not using webhooks
# WEBHOOK_URL=http://localhost:8000/agent-blocked

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

MAX_CODER_REVIEWER_ITERATIONS=3
MAX_PLANNING_UAT_ITERATIONS=2
ENABLE_VERBOSE_LOGGING=true

# ============================================================================
# WORKING DIRECTORY
# ============================================================================

DEFAULT_WORK_DIR=/tmp/lilagent-output
